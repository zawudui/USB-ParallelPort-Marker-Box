(version 1)
# r7: isolation barrier - any host-side net vs any isolated-side net must keep >= 3.0 mm copper clearance
# host nets (56): +3V3 /BOOT0 /BOOST_COMP /BOOST_EN /BOOST_FB /BOOST_SS /BOOST_SW /CC1 /CC2 /COMP_MID /ISO_PWR_EN /ISO_VIN /LED_K0 /VBUS_SW /LED_K1 /LED_K2 /LED_K3 /LED_K4 /LED_K5 /LED_K6 /LED_K7 /LED_KRDY /MARKER_D0 /MARKER_D1 /MARKER_D2 /MARKER_D3 /MARKER_D4 /MARKER_D5 /MARKER_D6 /MARKER_D7 /MARKER_READY /NRST /OSC_IN /OSC_OUT /OSC_OUT_XT /SWCLK /SWDIO /USB_DM /USB_DP /VCAP1 GND /Q1_GATE /Q2_DRAIN /Q3_GATE /ISO_BLEED Net-(Q2-G) Net-(U10-A) Net-(U11-A) Net-(U3-A) Net-(U4-A) Net-(U5-A) Net-(U6-A) Net-(U7-A) Net-(U8-A) Net-(U9-A) VBUS
# iso nets (28): /DB25_D0 /DB25_D1 /DB25_D2 /DB25_D3 /DB25_D4 /DB25_D5 /DB25_D6 /DB25_D7 /GND_ISO /READY_ISO /VCC_ISO Net-(R30-Pad1) Net-(R31-Pad1) Net-(R32-Pad1) Net-(R33-Pad1) Net-(R34-Pad1) Net-(R35-Pad1) Net-(R36-Pad1) Net-(R37-Pad1) Net-(U10-VO) Net-(U11-VO) Net-(U3-VO) Net-(U4-VO) Net-(U5-VO) Net-(U6-VO) Net-(U7-VO) Net-(U8-VO) Net-(U9-VO)
(rule "ISO_BARRIER_3mm"
  (constraint clearance (min 3.0mm))
  (condition "((A.NetName == '+3V3' || A.NetName == '/BOOT0' || A.NetName == '/CC1' || A.NetName == '/CC2' || A.NetName == '/ISO_PWR_EN' || A.NetName == '/BOOST_COMP' || A.NetName == '/BOOST_EN' || A.NetName == '/BOOST_FB' || A.NetName == '/BOOST_SS' || A.NetName == '/BOOST_SW' || A.NetName == '/COMP_MID' || A.NetName == '/ISO_VIN' || A.NetName == '/VBUS_SW' || A.NetName == '/LED_K0' || A.NetName == '/LED_K1' || A.NetName == '/LED_K2' || A.NetName == '/LED_K3' || A.NetName == '/LED_K4' || A.NetName == '/LED_K5' || A.NetName == '/LED_K6' || A.NetName == '/LED_K7' || A.NetName == '/LED_KRDY' || A.NetName == '/MARKER_D0' || A.NetName == '/MARKER_D1' || A.NetName == '/MARKER_D2' || A.NetName == '/MARKER_D3' || A.NetName == '/MARKER_D4' || A.NetName == '/MARKER_D5' || A.NetName == '/MARKER_D6' || A.NetName == '/MARKER_D7' || A.NetName == '/MARKER_READY' || A.NetName == '/NRST' || A.NetName == '/OSC_IN' || A.NetName == '/OSC_OUT' || A.NetName == '/OSC_OUT_XT' || A.NetName == '/SWCLK' || A.NetName == '/SWDIO' || A.NetName == '/USB_DM' || A.NetName == '/USB_DP' || A.NetName == '/VCAP1' || A.NetName == 'GND' || A.NetName == '/Q1_GATE' || A.NetName == '/Q2_DRAIN' || A.NetName == '/Q3_GATE' || A.NetName == '/ISO_BLEED' || A.NetName == 'Net-(Q2-G)' || A.NetName == 'Net-(U10-A)' || A.NetName == 'Net-(U11-A)' || A.NetName == 'Net-(U3-A)' || A.NetName == 'Net-(U4-A)' || A.NetName == 'Net-(U5-A)' || A.NetName == 'Net-(U6-A)' || A.NetName == 'Net-(U7-A)' || A.NetName == 'Net-(U8-A)' || A.NetName == 'Net-(U9-A)' || A.NetName == 'VBUS') && (B.NetName == '/DB25_D0' || B.NetName == '/DB25_D1' || B.NetName == '/DB25_D2' || B.NetName == '/DB25_D3' || B.NetName == '/DB25_D4' || B.NetName == '/DB25_D5' || B.NetName == '/DB25_D6' || B.NetName == '/DB25_D7' || B.NetName == '/GND_ISO' || B.NetName == '/READY_ISO' || B.NetName == '/VCC_ISO' || B.NetName == 'Net-(R30-Pad1)' || B.NetName == 'Net-(R31-Pad1)' || B.NetName == 'Net-(R32-Pad1)' || B.NetName == 'Net-(R33-Pad1)' || B.NetName == 'Net-(R34-Pad1)' || B.NetName == 'Net-(R35-Pad1)' || B.NetName == 'Net-(R36-Pad1)' || B.NetName == 'Net-(R37-Pad1)' || B.NetName == 'Net-(U10-VO)' || B.NetName == 'Net-(U11-VO)' || B.NetName == 'Net-(U3-VO)' || B.NetName == 'Net-(U4-VO)' || B.NetName == 'Net-(U5-VO)' || B.NetName == 'Net-(U6-VO)' || B.NetName == 'Net-(U7-VO)' || B.NetName == 'Net-(U8-VO)' || B.NetName == 'Net-(U9-VO)')) || ((A.NetName == '/DB25_D0' || A.NetName == '/DB25_D1' || A.NetName == '/DB25_D2' || A.NetName == '/DB25_D3' || A.NetName == '/DB25_D4' || A.NetName == '/DB25_D5' || A.NetName == '/DB25_D6' || A.NetName == '/DB25_D7' || A.NetName == '/GND_ISO' || A.NetName == '/READY_ISO' || A.NetName == '/VCC_ISO' || A.NetName == 'Net-(R30-Pad1)' || A.NetName == 'Net-(R31-Pad1)' || A.NetName == 'Net-(R32-Pad1)' || A.NetName == 'Net-(R33-Pad1)' || A.NetName == 'Net-(R34-Pad1)' || A.NetName == 'Net-(R35-Pad1)' || A.NetName == 'Net-(R36-Pad1)' || A.NetName == 'Net-(R37-Pad1)' || A.NetName == 'Net-(U10-VO)' || A.NetName == 'Net-(U11-VO)' || A.NetName == 'Net-(U3-VO)' || A.NetName == 'Net-(U4-VO)' || A.NetName == 'Net-(U5-VO)' || A.NetName == 'Net-(U6-VO)' || A.NetName == 'Net-(U7-VO)' || A.NetName == 'Net-(U8-VO)' || A.NetName == 'Net-(U9-VO)') && (B.NetName == '+3V3' || B.NetName == '/BOOT0' || B.NetName == '/CC1' || B.NetName == '/CC2' || B.NetName == '/ISO_PWR_EN' || B.NetName == '/BOOST_COMP' || B.NetName == '/BOOST_EN' || B.NetName == '/BOOST_FB' || B.NetName == '/BOOST_SS' || B.NetName == '/BOOST_SW' || B.NetName == '/COMP_MID' || B.NetName == '/ISO_VIN' || B.NetName == '/VBUS_SW' || B.NetName == '/LED_K0' || B.NetName == '/LED_K1' || B.NetName == '/LED_K2' || B.NetName == '/LED_K3' || B.NetName == '/LED_K4' || B.NetName == '/LED_K5' || B.NetName == '/LED_K6' || B.NetName == '/LED_K7' || B.NetName == '/LED_KRDY' || B.NetName == '/MARKER_D0' || B.NetName == '/MARKER_D1' || B.NetName == '/MARKER_D2' || B.NetName == '/MARKER_D3' || B.NetName == '/MARKER_D4' || B.NetName == '/MARKER_D5' || B.NetName == '/MARKER_D6' || B.NetName == '/MARKER_D7' || B.NetName == '/MARKER_READY' || B.NetName == '/NRST' || B.NetName == '/OSC_IN' || B.NetName == '/OSC_OUT' || B.NetName == '/OSC_OUT_XT' || B.NetName == '/SWCLK' || B.NetName == '/SWDIO' || B.NetName == '/USB_DM' || B.NetName == '/USB_DP' || B.NetName == '/VCAP1' || B.NetName == 'GND' || B.NetName == '/Q1_GATE' || B.NetName == '/Q2_DRAIN' || B.NetName == '/Q3_GATE' || B.NetName == '/ISO_BLEED' || B.NetName == 'Net-(Q2-G)' || B.NetName == 'Net-(U10-A)' || B.NetName == 'Net-(U11-A)' || B.NetName == 'Net-(U3-A)' || B.NetName == 'Net-(U4-A)' || B.NetName == 'Net-(U5-A)' || B.NetName == 'Net-(U6-A)' || B.NetName == 'Net-(U7-A)' || B.NetName == 'Net-(U8-A)' || B.NetName == 'Net-(U9-A)' || B.NetName == 'VBUS'))"))
# J1 corner GND lands A1/B12 and A12/B1 are shortened on the peg side (1.15 -> 1.10 mm).
# With that trim, KiCad 9.0.9 reports no hole-clearance error against the board-wide 0.25 mm
# rule, so the old J1-only 0.15 mm exemption is removed. Signal pads stay at the vendor 1.15 mm.
