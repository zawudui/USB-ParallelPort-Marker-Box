	(paper "A0")
	(title_block
		(title "USB CDC to DB25 8-bit Marker Adapter")
		(date "2026-10-19")
		(rev "r7.2")
		(company "marker-box")
		(comment 1 "r7.2 schematic: TPS61085PWR ~6.30 V boost after Q1, DB25 D0-D7 TVS to GND_ISO. Q3 gate fix: R98=1k, R99 removed; previous PCB requires reroute. Q1 gate is slew-limited, ISO_VIN discharges when Q1 is off, boost ceramics are 25 V.")
		(comment 2 "NOT FOR FAB — r7.2 schematic and PCB, no Gerber and no powered test")
	)
	(text "r6 DRIVE: R10-R18 = 330 ohm 1% from VBUS; LED cathode sunk by U15/U16 SN74LVC06A. Worst IF 6.15 mA min / 13.8 mA max. See 6N137驱动电流核算-r6.md"
		(exclude_from_sim no)
